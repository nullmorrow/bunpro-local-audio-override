{
  "about": "Reading-check cases for the VOICEVOX integration. engineKana values were observed from a local VOICEVOX Engine 0.25.2 (speaker style 3) via POST /audio_query; they are the 'kana' field (AquesTalk-style: ' marks the accent nucleus, / separates accent phrases, _ marks a devoiced mora, 、 a pause, ？ a question). html mimics BunPro's cloze sentence markup inside the question .text-center root (per-kanji or per-word <ruby> with <rp>/<rt>; the revealed answer sits in a <button>).",
  "expectValues": {
    "matched": "level 1 reading equals furigana reading after normalization",
    "corrected": "level 2 kana substitution of only the misread ruby bases fixes it",
    "partial": "some kanji lack ruby; annotated parts verified",
    "unverified": "no ruby at all"
  },
  "cases": [
    {
      "id": "nihon-word-ruby",
      "html": "<span class=\"bp-ddw\" data-force-furigana=\"default\"><ruby class=\"cursor-pointer\">日本<rp>(</rp><rt>にほん</rt><rp>)</rp></ruby>に</span><button title=\"Return to the question input\"><span class=\"inline-block  text-correct\"><span class=\"bp-ddw\" data-force-furigana=\"default\"><ruby class=\"cursor-pointer\">行<rp>(</rp><rt>い</rt><rp>)</rp></ruby>った</span></span></button><span class=\"bp-ddw\" data-force-furigana=\"default\">。</span>",
      "surface": "日本に行った。",
      "reading": "にほんにいった。",
      "engineKana1": "ニッポ'ンニ/イッタ'",
      "expect": "corrected",
      "level2Text": "にほんに行った。",
      "engineKana2": "ニホ'ンニ/イッタ'",
      "misread": [
        "日本"
      ]
    },
    {
      "id": "karai-per-kanji",
      "html": "<span class=\"bp-ddw\" data-force-furigana=\"default\"><ruby class=\"cursor-pointer\">辛<rp>(</rp><rt>から</rt><rp>)</rp></ruby>い<ruby class=\"cursor-pointer\">物<rp>(</rp><rt>もの</rt><rp>)</rp></ruby>が</span><button title=\"Return to the question input\"><span class=\"inline-block  text-correct\"><span class=\"bp-ddw\" data-force-furigana=\"default\"><ruby class=\"cursor-pointer\">好<rp>(</rp><rt>す</rt><rp>)</rp></ruby>き</span></span></button><span class=\"bp-ddw\" data-force-furigana=\"default\">です。</span>",
      "surface": "辛い物が好きです。",
      "reading": "からいものがすきです。",
      "engineKana1": "ツラ'イ/モノ'ガ/_スキ'デ_ス",
      "expect": "corrected",
      "level2Text": "からい物が好きです。",
      "engineKana2": "カラ'イ/モノ'ガ/_スキ'デ_ス",
      "misread": [
        "辛"
      ]
    },
    {
      "id": "nan-no",
      "html": "<span class=\"bp-ddw\" data-force-furigana=\"default\"><ruby class=\"cursor-pointer\">何<rp>(</rp><rt>なん</rt><rp>)</rp></ruby>の<ruby class=\"cursor-pointer\">本<rp>(</rp><rt>ほん</rt><rp>)</rp></ruby></span><button title=\"Return to the question input\"><span class=\"inline-block  text-correct\"><span class=\"bp-ddw\" data-force-furigana=\"default\">ですか</span></span></button><span class=\"bp-ddw\" data-force-furigana=\"default\">。</span>",
      "surface": "何の本ですか。",
      "reading": "なんのほんですか。",
      "engineKana1": "ナ'ニノ/ホ'ンデ_スカ",
      "expect": "corrected",
      "level2Text": "なんの本ですか。",
      "engineKana2": "ナ'ンノ/ホ'ンデ_スカ",
      "misread": [
        "何"
      ]
    },
    {
      "id": "particles-wa-wo",
      "html": "<span class=\"bp-ddw\" data-force-furigana=\"default\"><ruby class=\"cursor-pointer\">私<rp>(</rp><rt>わたし</rt><rp>)</rp></ruby>は<ruby class=\"cursor-pointer\">何<rp>(</rp><rt>なに</rt><rp>)</rp></ruby></span><button title=\"Return to the question input\"><span class=\"inline-block  text-correct\"><span class=\"bp-ddw\" data-force-furigana=\"default\">を</span></span></button><span class=\"bp-ddw\" data-force-furigana=\"default\"><ruby class=\"cursor-pointer\">食<rp>(</rp><rt>た</rt><rp>)</rp></ruby>べますか？</span>",
